# AI Research Workspace - Backend Environment Variables

# Set your Gemini API key (Required for live agent runs)
GEMINI_API_KEY=your_gemini_api_key_here

# Database Mode: "sqlite" (default) or "postgres"
DATABASE_MODE=sqlite

# JWT Secret Key (Change this in production!)
SECRET_KEY=super_secret_session_token_key_change_in_production

# PostgreSQL Config (Only used if DATABASE_MODE=postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=research_db

# Redis Config (Used for caching/state caching - falls back to memory if unavailable)
REDIS_HOST=localhost
REDIS_PORT=6379
